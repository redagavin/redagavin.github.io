source "https://rubygems.org"

# Built by GitHub Actions (.github/workflows/pages.yml), not the legacy
# github-pages gem. Ruby version lives in .ruby-version.
#
#     bundle install
#     bundle exec jekyll serve

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.18"
  gem "jekyll-sitemap", "~> 1.4"
  gem "jekyll-redirect-from", "~> 0.17"
end

# Needed by `jekyll serve`; no longer a default gem since Ruby 3.0.
gem "webrick", "~> 1.9"
